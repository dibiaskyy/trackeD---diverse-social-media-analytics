{
  "name": "tracked",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"next,scraper\" -c \"cyan,magenta\" \"npm run dev --prefix frontend\" \"node scraper-service/index.js\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:scraper": "node scraper-service/index.js",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
